<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.ReaderMapper">
    
    <resultMap type="Reader" id="ReaderResult">
        <result property="readerId"    column="reader_id"    />
        <result property="readerName"    column="reader_name"    />
        <result property="phone"    column="phone"    />
        <result property="email"    column="email"    />
        <!-- password_hash 仅 selectAuthInfo 查询包含该列；普通查询（selectReaderVo）不含，防泄露 -->
        <result property="passwordHash" column="password_hash" />
        <result property="cardNo"    column="card_no"    />
        <result property="readerType"    column="reader_type"    />
        <result property="sex"    column="sex"    />
        <result property="birthDate"    column="birth_date"    />
        <result property="status"    column="status"    />
        <result property="lastLoginTime" column="last_login_time" />
        <result property="pwdSet"    column="pwd_set"    />
        <result property="emailVerified" column="email_verified" />
        <result property="phoneVerified" column="phone_verified" />
        <result property="remark"    column="remark"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="deletedBy"  column="deleted_by"  />
        <result property="deletedTime" column="deleted_time" />
    </resultMap>

    <!-- 注意：普通查询不含 password_hash（防密码哈希泄露到列表/前台接口），仅 selectAuthInfo 含 -->
    <sql id="selectReaderVo">
        select reader_id, reader_name, phone, email, card_no, reader_type, sex, birth_date, status, last_login_time, pwd_set, email_verified, phone_verified, del_flag, deleted_by, deleted_time, remark, create_by, create_time, update_by, update_time from reader
    </sql>

    <select id="selectReaderList" parameterType="Reader" resultMap="ReaderResult">
        <include refid="selectReaderVo"/>
        <where>
            <if test="delFlag == null or delFlag == ''"> and del_flag = '0'</if>
            <if test="delFlag != null and delFlag != ''"> and del_flag = #{delFlag}</if>
            <if test="readerName != null  and readerName != ''"> and reader_name like concat('%', #{readerName}, '%')</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="cardNo != null  and cardNo != ''"> and card_no = #{cardNo}</if>
            <if test="readerType != null  and readerType != ''"> and reader_type = #{readerType}</if>
            <if test="sex != null  and sex != ''"> and sex = #{sex}</if>
            <if test="birthDate != null "> and birth_date = #{birthDate}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectReaderByReaderId" parameterType="Long" resultMap="ReaderResult">
        <include refid="selectReaderVo"/>
        where reader_id = #{readerId} and del_flag = '0'
    </select>

    <select id="selectReaderByReaderIdForUpdate" parameterType="Long" resultMap="ReaderResult">
        <include refid="selectReaderVo"/>
        where reader_id = #{readerId} and del_flag = '0' for update
    </select>

    <insert id="insertReader" parameterType="Reader" useGeneratedKeys="true" keyProperty="readerId">
        insert into reader
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="readerName != null and readerName != ''">reader_name,</if>
            <if test="phone != null">phone,</if>
            <if test="email != null">email,</if>
            <if test="passwordHash != null">password_hash,</if>
            <if test="pwdSet != null">pwd_set,</if>
            <if test="emailVerified != null">email_verified,</if>
            <if test="cardNo != null">card_no,</if>
            <if test="readerType != null">reader_type,</if>
            <if test="sex != null">sex,</if>
            <if test="birthDate != null">birth_date,</if>
            <if test="status != null">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="readerName != null and readerName != ''">#{readerName},</if>
            <if test="phone != null">#{phone},</if>
            <if test="email != null">#{email},</if>
            <if test="passwordHash != null">#{passwordHash},</if>
            <if test="pwdSet != null">#{pwdSet},</if>
            <if test="emailVerified != null">#{emailVerified},</if>
            <if test="cardNo != null">#{cardNo},</if>
            <if test="readerType != null">#{readerType},</if>
            <if test="sex != null">#{sex},</if>
            <if test="birthDate != null">#{birthDate},</if>
            <if test="status != null">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateReader" parameterType="Reader">
        update reader
        <trim prefix="SET" suffixOverrides=",">
            <if test="readerName != null and readerName != ''">reader_name = #{readerName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="cardNo != null">card_no = #{cardNo},</if>
            <if test="readerType != null">reader_type = #{readerType},</if>
            <if test="sex != null">sex = #{sex},</if>
            <if test="birthDate != null">birth_date = #{birthDate},</if>
            <if test="status != null">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where reader_id = #{readerId}
    </update>

    <delete id="deleteReaderByReaderId" parameterType="Long">
        delete from reader where reader_id = #{readerId}
    </delete>

    <delete id="deleteReaderByReaderIds" parameterType="String">
        delete from reader where reader_id in
        <foreach item="readerId" collection="array" open="(" separator="," close=")">
            #{readerId}
        </foreach>
    </delete>

    <!-- 软删除（两态）：标记 del_flag='2'，仅对未删除行生效（幂等） -->
    <update id="softDeleteReaderByReaderIds">
        update reader set del_flag = '2', deleted_by = #{deletedBy}, deleted_time = #{deletedTime}
        where reader_id in
        <foreach item="readerId" collection="readerIds" open="(" separator="," close=")">#{readerId}</foreach>
        and del_flag = '0'
    </update>

    <!-- 恢复（两态）：del_flag 置 '0'，清空删除人/时间；仅对已删除行生效（幂等） -->
    <update id="restoreReaderByReaderIds">
        update reader set del_flag = '0', deleted_by = '', deleted_time = null
        where reader_id in
        <foreach item="readerId" collection="readerIds" open="(" separator="," close=")">#{readerId}</foreach>
        and del_flag = '2'
    </update>

    <!-- 批量导入判重：借书证号是否已存在 -->
    <select id="countByCardNo" parameterType="String" resultType="int">
        select count(1) from reader where card_no = #{cardNo}
    </select>

    <!-- 邮箱判重（改邮箱/注册前友好提示，uk_email 兜底） -->
    <select id="countByEmail" parameterType="String" resultType="int">
        select count(1) from reader where email = #{email} and del_flag = '0'
    </select>

    <!-- 手机号判重（注册前校验；phone 无唯一索引，防同号多账号导致登录/找回解析歧义） -->
    <select id="countByPhone" parameterType="String" resultType="int">
        select count(1) from reader where phone = #{phone} and del_flag = '0'
    </select>

    <!-- 认证专用查询：含 password_hash（登录/改密/重置；普通查询不含，防泄露）
         登录标识支持：证号 / 手机号 / 邮箱（email 与 card_no 唯一，phone 取第一条）
         排序固定：优先已设密码的账号（可正常登录），再按 reader_id 取最早注册的——解析结果确定，防执行计划歧义 -->
    <select id="selectAuthInfo" parameterType="String" resultMap="ReaderResult">
        select reader_id, reader_name, phone, email, password_hash, pwd_set, email_verified, card_no, reader_type, sex, birth_date, status, last_login_time, del_flag
        from reader
        where del_flag = '0' and (card_no = #{account} or phone = #{account} or email = #{account})
        order by case when pwd_set = '1' then 0 else 1 end, reader_id
        limit 1
    </select>

    <!-- 更新认证字段（密码/邮箱验证状态/最后登录时间） -->
    <update id="updateAuth" parameterType="Reader">
        update reader
        <trim prefix="SET" suffixOverrides=",">
            <if test="passwordHash != null">password_hash = #{passwordHash},</if>
            <if test="pwdSet != null">pwd_set = #{pwdSet},</if>
            <if test="emailVerified != null">email_verified = #{emailVerified},</if>
            <if test="phoneVerified != null">phone_verified = #{phoneVerified},</if>
            <if test="lastLoginTime != null">last_login_time = #{lastLoginTime},</if>
        </trim>
        where reader_id = #{readerId}
    </update>

    <!-- 修改邮箱：同时重置验证状态（changeEmail 流程专用） -->
    <update id="updateEmail" parameterType="Reader">
        update reader set email = #{email}, email_verified = '0', update_time = NOW()
        where reader_id = #{readerId}
    </update>
</mapper>