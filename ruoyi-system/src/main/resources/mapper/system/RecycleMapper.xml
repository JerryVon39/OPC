<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.RecycleMapper">

    <!-- ================= 图书回收站 ================= -->
    <resultMap type="Book" id="RecycleBookResult">
        <result property="recycleId"   column="recycle_id"   />
        <result property="bookId"      column="book_id"      />
        <result property="bookName"    column="book_name"    />
        <result property="author"      column="author"       />
        <result property="bookType"    column="book_type"    />
        <result property="publisher"   column="publisher"    />
        <result property="price"       column="price"        />
        <result property="publishDate" column="publish_date" />
        <result property="stock"       column="stock"        />
        <result property="status"      column="status"       />
        <result property="cover"       column="cover"        />
        <result property="isbn"        column="isbn"         />
        <result property="intro"       column="intro"        />
        <result property="remark"      column="remark"       />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="deletedBy"   column="deleted_by"   />
        <result property="deletedTime" column="deleted_time" />
    </resultMap>

    <sql id="recycleBookColumns">
        recycle_id, book_id, book_name, author, book_type, publisher, price, publish_date, stock,
        status, cover, isbn, intro, remark, create_by, create_time, update_by, update_time, deleted_by, deleted_time
    </sql>

    <select id="selectRecycleBookList" parameterType="Book" resultMap="RecycleBookResult">
        select <include refid="recycleBookColumns"/> from book_recycle
        <where>
            <if test="bookName != null and bookName != ''"> and book_name like concat('%', #{bookName}, '%')</if>
        </where>
        order by deleted_time desc
    </select>

    <select id="selectRecycleBookById" parameterType="Long" resultMap="RecycleBookResult">
        select <include refid="recycleBookColumns"/> from book_recycle where recycle_id = #{recycleId}
    </select>

    <insert id="insertRecycleBook" parameterType="Book" useGeneratedKeys="true" keyProperty="recycleId">
        insert into book_recycle (book_id, book_name, author, book_type, publisher, price, publish_date, stock,
            status, cover, isbn, intro, remark, create_by, create_time, update_by, update_time, deleted_by, deleted_time)
        values (#{bookId}, #{bookName}, #{author}, #{bookType}, #{publisher}, #{price}, #{publishDate}, #{stock},
            #{status}, #{cover}, #{isbn}, #{intro}, #{remark}, #{createBy}, #{createTime}, #{updateBy}, #{updateTime}, #{deletedBy}, #{deletedTime})
    </insert>

    <delete id="deleteRecycleBookByIds">
        delete from book_recycle where recycle_id in
        <foreach item="id" collection="recycleIds" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <delete id="clearRecycleBook">
        delete from book_recycle
    </delete>

    <select id="countRecycleBook" resultType="int">
        select count(1) from book_recycle
    </select>

    <!-- ================= 读者回收站 ================= -->
    <resultMap type="Reader" id="RecycleReaderResult">
        <result property="recycleId"   column="recycle_id"   />
        <result property="readerId"    column="reader_id"    />
        <result property="readerName"  column="reader_name"  />
        <result property="phone"       column="phone"        />
        <result property="cardNo"      column="card_no"      />
        <result property="readerType"  column="reader_type"  />
        <result property="sex"         column="sex"          />
        <result property="birthDate"   column="birth_date"   />
        <result property="status"      column="status"       />
        <result property="remark"      column="remark"       />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="deletedBy"   column="deleted_by"   />
        <result property="deletedTime" column="deleted_time" />
    </resultMap>

    <sql id="recycleReaderColumns">
        recycle_id, reader_id, reader_name, phone, card_no, reader_type, sex, birth_date,
        status, remark, create_by, create_time, update_by, update_time, deleted_by, deleted_time
    </sql>

    <select id="selectRecycleReaderList" parameterType="Reader" resultMap="RecycleReaderResult">
        select <include refid="recycleReaderColumns"/> from reader_recycle
        <where>
            <if test="readerName != null and readerName != ''"> and reader_name like concat('%', #{readerName}, '%')</if>
        </where>
        order by deleted_time desc
    </select>

    <select id="selectRecycleReaderById" parameterType="Long" resultMap="RecycleReaderResult">
        select <include refid="recycleReaderColumns"/> from reader_recycle where recycle_id = #{recycleId}
    </select>

    <insert id="insertRecycleReader" parameterType="Reader" useGeneratedKeys="true" keyProperty="recycleId">
        insert into reader_recycle (reader_id, reader_name, phone, card_no, reader_type, sex, birth_date,
            status, remark, create_by, create_time, update_by, update_time, deleted_by, deleted_time)
        values (#{readerId}, #{readerName}, #{phone}, #{cardNo}, #{readerType}, #{sex}, #{birthDate},
            #{status}, #{remark}, #{createBy}, #{createTime}, #{updateBy}, #{updateTime}, #{deletedBy}, #{deletedTime})
    </insert>

    <delete id="deleteRecycleReaderByIds">
        delete from reader_recycle where recycle_id in
        <foreach item="id" collection="recycleIds" open="(" separator="," close=")">#{id}</foreach>
    </delete>

    <delete id="clearRecycleReader">
        delete from reader_recycle
    </delete>

    <select id="countRecycleReader" resultType="int">
        select count(1) from reader_recycle
    </select>
</mapper>