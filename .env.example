# ============================================
# 数智游民创新工场 · 环境配置示例
# 用法：复制本文件为 .env 后按需修改（docker compose 自动读取）
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# 数据库/Redis 留空可用演示默认值；TOKEN_SECRET 必须非空（start-all/start-local 会自动生成）；
# 生产部署请全部设置
# ============================================

# ---------- 数据库 ----------
# MySQL root 密码（默认 password 仅用于演示，生产务必修改强口令）
MYSQL_ROOT_PASSWORD=password
# 后端连接数据库密码（留空则默认跟随 MYSQL_ROOT_PASSWORD，docker-compose 已联动）
DB_PASSWORD=

# ---------- Redis ----------
# Redis 密码（留空 = 无密码；设置后后端自动使用）
REDIS_PASSWORD=

# ---------- 本机开发（start-local 脚本用，可选） ----------
# 前端端口（默认 8081，避开若依默认的 80）
FE_PORT=8081
# 本机原生 MySQL/Redis 安装目录（默认探测 %USERPROFILE%\tools 或 PATH；
# 探测不到时脚本自动改用 Docker 拉起容器）
TOOLS_HOME=

# ---------- JWT 签名密钥 ----------
# 后端强制要求强随机密钥（拒绝使用仓库默认值启动）；留空时 start-all / start-local
# 脚本会自动生成并写入本文件，无需手工设置。生产可自行用 openssl rand -hex 32 生成
TOKEN_SECRET=

# ---------- 邮件通知（可选，QQ 邮箱 SMTP） ----------
# 不配置则不发邮件，业务不受影响；MAIL_ENABLED=false 彻底关闭邮件（优先于后台配置）
MAIL_ENABLED=true
# 发件邮箱（QQ 邮箱 → 设置 → 账户 → 开启 SMTP 服务，获取授权码填入 MAIL_AUTH_CODE）
MAIL_USERNAME=
MAIL_AUTH_CODE=
# 授权码 AES 加密密钥（任意长随机串，如 openssl rand -hex 32）；
# 未设置时后台「邮件通知」保存授权码会被拒绝（防明文落库）
MAIL_SECRET_KEY=

# ---------- Druid 监控台（默认关闭） ----------
# 排查慢 SQL 时开启，并务必修改口令
DRUID_STAT_ENABLED=false
DRUID_USERNAME=ruoyi
DRUID_PASSWORD=123456
